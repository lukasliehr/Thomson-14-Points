module

public import N14Cert.LocalN12.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.LocalN12

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 5, j := 5, k := 5, use := 3, tree := hex% "" },
    { i := 5, j := 6, k := 5, use := 3, tree := hex% "" },
    { i := 6, j := 4, k := 5, use := 3, tree := hex% "" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 4, c1 := 23, e2 := 4, c2 := 23, e3 := 4, c3 := 12 } (4191460) cells0 = true := by
  decide +kernel

/-- The cells of the group 1. -/
noncomputable def cells1 : List Cell :=
  [{ i := 4, j := 4, k := 6, use := 3, tree := hex% "" }]

/-- The group 1: the cover of a box by its cells. -/
theorem g1_ok : boxOk run { e1 := 4, c1 := 23, e2 := 4, c2 := 23, e3 := 4, c3 := 13 } (16356) cells1 = true := by
  decide +kernel

end N14Cert.LocalN12
