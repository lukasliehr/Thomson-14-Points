module

public import N14Cert.AnnN19.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.AnnN19

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 6, j := 7, k := 6, use := 3, tree := 3 },
    { i := 7, j := 7, k := 7, use := 3, tree := 3681354449 },
    { i := 8, j := 7, k := 7, use := 3, tree := hex% "" },
    { i := 5, j := 6, k := 4, use := 3, tree := hex% "db6da60b40b65065a" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 1, c1 := 0, e2 := 1, c2 := 1, e3 := 1, c3 := 2 } (hex% "3ffce73bfcecb4edce7393b4") cells0 = true := by
  decide +kernel

end N14Cert.AnnN19
