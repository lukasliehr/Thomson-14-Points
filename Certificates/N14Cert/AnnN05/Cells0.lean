module

public import N14Cert.AnnN05.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.AnnN05

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 8, j := 8, k := 7, use := 3, tree := hex% "d969b6db05a05349a" },
    { i := 8, j := 9, k := 8, use := 3, tree := hex% "" },
    { i := 9, j := 7, k := 7, use := 3, tree := hex% "" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 1, c1 := 1, e2 := 1, c2 := 2, e3 := 1, c3 := 0 } (hex% "3ffffffb4e739cb4e73b4b4b4") cells0 = true := by
  decide +kernel

end N14Cert.AnnN05
