    { i := 11, j := 13, k := 16, use := 3, tree := hex% "" }]

/-- The group 1: the cover of a box by its cells. -/
theorem g1_ok : boxOk run { e1 := 7, c1 := 12, e2 := 6, c2 := 6, e3 := 6, c3 := 102 } (4119789) cells1 = true := by
  decide +kernel

