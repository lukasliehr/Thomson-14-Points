module

public import N14Cert.LocalN14.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.LocalN14

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 7. -/
noncomputable def cells7 : List Cell :=
  [{ i := 20, j := 21, k := 25, use := 3, tree := hex% "" }]

/-- The group 7: the cover of a box by its cells. -/
theorem g7_ok : boxOk run { e1 := 9, c1 := 53, e2 := 9, c2 := 54, e3 := 9, c3 := 821 } (3) cells7 = true := by
  decide +kernel

/-- The cells of the group 8. -/
noncomputable def cells8 : List Cell :=
  [{ i := 20, j := 22, k := 24, use := 3, tree := hex% "" }]

/-- The group 8: the cover of a box by its cells. -/
theorem g8_ok : boxOk run { e1 := 9, c1 := 53, e2 := 9, c2 := 55, e3 := 9, c3 := 820 } (3) cells8 = true := by
  decide +kernel

end N14Cert.LocalN14
