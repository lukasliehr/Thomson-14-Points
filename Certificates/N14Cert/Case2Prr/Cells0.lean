module

public import N14Cert.Case2Prr.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case2Prr

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 3, j := 0, k := 0, use := 0, tree := 5 },
    { i := 4, j := 3, k := 0, use := 0, tree := 5 },
    { i := 4, j := 4, k := 0, use := 0, tree := hex% "4800000000000000b0000000000000000000000002660ae474" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 1, c1 := 0, e2 := 1, c2 := 0, e3 := 1, c3 := 0 } (988) cells0 = true := by
  decide +kernel

/-- The cells of the group 1. -/
noncomputable def cells1 : List Cell :=
  [{ i := 3, j := 3, k := 1, use := 0, tree := 5 },
    { i := 3, j := 4, k := 5, use := 0, tree := 5 },
    { i := 10, j := 4, k := 6, use := 0, tree := 5 },
    { i := 11, j := 12, k := 6, use := 0, tree := hex% "140a050280000000000000000000000000000000000000000000000000000000012a79c7c411" },
    { i := 11, j := 13, k := 6, use := 0, tree := hex% "" }]

/-- The group 1: the cover of a box by its cells. -/
theorem g1_ok : boxOk run { e1 := 2, c1 := 0, e2 := 1, c2 := 0, e3 := 1, c3 := 1 } (253165) cells1 = true := by
  decide +kernel

/-- The cells of the group 2. -/
noncomputable def cells2 : List Cell :=
  [{ i := 4, j := 3, k := 1, use := 0, tree := hex% "d954b060800000000000000000000000000000000000000091c606734" }]

/-- The group 2: the cover of a box by its cells. -/
theorem g2_ok : boxOk run { e1 := 2, c1 := 1, e2 := 2, c2 := 0, e3 := 1, c3 := 1 } (3) cells2 = true := by
  decide +kernel

/-- The cells of the group 3. -/
noncomputable def cells3 : List Cell :=
  [{ i := 12, j := 12, k := 5, use := 0, tree := 5 },
    { i := 12, j := 13, k := 14, use := 0, tree := 5 },
    { i := 12, j := 13, k := 15, use := 0, tree := hex% "" }]

/-- The group 3: the cover of a box by its cells. -/
theorem g3_ok : boxOk run { e1 := 3, c1 := 2, e2 := 2, c2 := 1, e3 := 2, c3 := 2 } (1005) cells3 = true := by
  decide +kernel

/-- The cells of the group 4. -/
noncomputable def cells4 : List Cell :=
  [{ i := 13, j := 12, k := 5, use := 0, tree := hex% "73f97a18000000000000000000000000000000000000000052a83fe4" }]

/-- The group 4: the cover of a box by its cells. -/
theorem g4_ok : boxOk run { e1 := 3, c1 := 3, e2 := 3, c2 := 2, e3 := 2, c3 := 2 } (3) cells4 = true := by
  decide +kernel

/-- The cells of the group 5. -/
noncomputable def cells5 : List Cell :=
  [{ i := 13, j := 13, k := 14, use := 0, tree := hex% "" }]

/-- The group 5: the cover of a box by its cells. -/
theorem g5_ok : boxOk run { e1 := 3, c1 := 3, e2 := 3, c2 := 3, e3 := 3, c3 := 4 } (3) cells5 = true := by
  decide +kernel

end N14Cert.Case2Prr
