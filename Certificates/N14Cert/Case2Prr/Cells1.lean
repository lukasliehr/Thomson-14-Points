module

public import N14Cert.Case2Prr.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case2Prr

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 6. -/
noncomputable def cells6 : List Cell :=
  [{ i := 13, j := 13, k := 15, use := 0, tree := hex% "" }]

/-- The group 6: the cover of a box by its cells. -/
theorem g6_ok : boxOk run { e1 := 3, c1 := 3, e2 := 3, c2 := 3, e3 := 3, c3 := 5 } (3) cells6 = true := by
  decide +kernel

