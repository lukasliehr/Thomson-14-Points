noncomputable def cells78 : List Cell :=
  [{ i := 58, j := 41, k := 47, use := 0, tree := hex% "" },
    { i := 59, j := 41, k := 47, use := 0, tree := hex% "" },
    { i := 26, j := 41, k := 48, use := 0, tree := hex% "" }]

