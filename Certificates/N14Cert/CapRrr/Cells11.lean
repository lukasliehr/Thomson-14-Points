/-- The cells of the group 114. -/
noncomputable def cells114 : List Cell :=
  [{ i := 60, j := 43, k := 48, use := 0, tree := 5 },
    { i := 61, j := 92, k := 48, use := 0, tree := hex% "" },
    { i := 61, j := 93, k := 48, use := 0, tree := hex% "140a05000000000000000000000000000000000000000000000000000000000072125380000000000000000000000000000000000000000000000000000000000c6a883000000000000000000000000000000000000000000000000000000000013d130a141014802a" }]

/-- The group 114: the cover of a box by its cells. -/
theorem g114_ok : boxOk run { e1 := 4, c1 := 2, e2 := 4, c2 := 18, e3 := 4, c3 := 23 } (988) cells114 = true := by
  decide +kernel

