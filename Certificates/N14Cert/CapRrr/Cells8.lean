/-- The cells of the group 87. -/
noncomputable def cells87 : List Cell :=
  [{ i := 125, j := 94, k := 95, use := 0, tree := 5 },
    { i := 126, j := 195, k := 194, use := 0, tree := hex% "" },
    { i := 126, j := 195, k := 195, use := 0, tree := hex% "" },
    { i := 126, j := 196, k := 95, use := 0, tree := hex% "" }]

/-- The group 87: the cover of a box by its cells. -/
theorem g87_ok : boxOk run { e1 := 5, c1 := 3, e2 := 5, c2 := 38, e3 := 5, c3 := 41 } (16284) cells87 = true := by
  decide +kernel

