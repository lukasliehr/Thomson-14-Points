module

public import N14Cert.CapPpr.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.CapPpr

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 44. -/
noncomputable def cells44 : List Cell :=
  [{ i := 5, j := 77, k := 90, use := 0, tree := hex% "" },
    { i := 5, j := 77, k := 91, use := 0, tree := hex% "" }]

/-- The group 44: the cover of a box by its cells. -/
theorem g44_ok : boxOk run { e1 := 5, c1 := 0, e2 := 5, c2 := 22, e3 := 4, c3 := 18 } (15602) cells44 = true := by
  decide +kernel

