/-- The cells of the group 55. -/
noncomputable def cells55 : List Cell :=
  [{ i := 5, j := 73, k := 96, use := 0, tree := hex% "" },
    { i := 5, j := 73, k := 97, use := 0, tree := hex% "" }]

/-- The group 55: the cover of a box by its cells. -/
theorem g55_ok : boxOk run { e1 := 5, c1 := 0, e2 := 5, c2 := 18, e3 := 4, c3 := 21 } (15602) cells55 = true := by
  decide +kernel

