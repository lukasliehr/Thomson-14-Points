module

public import N14Cert.CapPpr.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.CapPpr

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 80. -/
noncomputable def cells80 : List Cell :=
  [{ i := 6, j := 155, k := 206, use := 0, tree := hex% "" },
    { i := 7, j := 155, k := 206, use := 0, tree := hex% "" },
    { i := 5, j := 155, k := 207, use := 0, tree := hex% "" }]

/-- The group 80: the cover of a box by its cells. -/
theorem g80_ok : boxOk run { e1 := 6, c1 := 0, e2 := 6, c2 := 40, e3 := 5, c3 := 47 } (1010) cells80 = true := by
  decide +kernel

