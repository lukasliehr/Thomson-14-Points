/-- The cells of the group 207. -/
noncomputable def cells207 : List Cell :=
  [{ i := 135, j := 199, k := 213, use := 0, tree := hex% "" },
    { i := 135, j := 199, k := 214, use := 0, tree := hex% "" }]

/-- The group 207: the cover of a box by its cells. -/
theorem g207_ok : boxOk run { e1 := 6, c1 := 17, e2 := 6, c2 := 80, e3 := 5, c3 := 47 } (62) cells207 = true := by
  decide +kernel

