/-- The cells of the group 322. -/
noncomputable def cells322 : List Cell :=
  [{ i := 64, j := 43, k := 50, use := 0, tree := hex% "" },
    { i := 65, j := 43, k := 50, use := 0, tree := hex% "" }]

