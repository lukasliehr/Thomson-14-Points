/-- The cells of the group 219. -/
noncomputable def cells219 : List Cell :=
  [{ i := 137, j := 202, k := 213, use := 0, tree := hex% "" },
    { i := 137, j := 202, k := 214, use := 0, tree := hex% "" }]

/-- The group 219: the cover of a box by its cells. -/
theorem g219_ok : boxOk run { e1 := 6, c1 := 19, e2 := 6, c2 := 83, e3 := 5, c3 := 47 } (62) cells219 = true := by
  decide +kernel

