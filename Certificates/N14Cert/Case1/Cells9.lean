module

public import N14Cert.Case1.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case1

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 72. -/
noncomputable def cells72 : List Cell :=
  [{ i := 10, j := 16, k := 17, use := 0, tree := hex% "" }]

/-- The group 72: the cover of a box by its cells. -/
theorem g72_ok : boxOk run { e1 := 3, c1 := 0, e2 := 3, c2 := 6, e3 := 3, c3 := 7 } (3) cells72 = true := by
  decide +kernel

