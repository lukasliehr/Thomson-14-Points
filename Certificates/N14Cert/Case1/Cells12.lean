module

public import N14Cert.Case1.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case1

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 95. -/
noncomputable def cells95 : List Cell :=
  [{ i := 25, j := 33, k := 45, use := 0, tree := hex% "" },
    { i := 25, j := 33, k := 46, use := 0, tree := hex% "" }]

/-- The group 95: the cover of a box by its cells. -/
theorem g95_ok : boxOk run { e1 := 4, c1 := 0, e2 := 4, c2 := 8, e3 := 3, c3 := 10 } (62) cells95 = true := by
  decide +kernel

