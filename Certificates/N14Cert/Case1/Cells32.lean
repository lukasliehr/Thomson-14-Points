/-- The cells of the group 258. -/
noncomputable def cells258 : List Cell :=
  [{ i := 140, j := 205, k := 213, use := 0, tree := hex% "" },
    { i := 140, j := 205, k := 214, use := 0, tree := hex% "" }]

/-- The group 258: the cover of a box by its cells. -/
theorem g258_ok : boxOk run { e1 := 6, c1 := 22, e2 := 6, c2 := 86, e3 := 5, c3 := 47 } (62) cells258 = true := by
  decide +kernel

