set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 87. -/
noncomputable def cells87 : List Cell :=
  [{ i := 25, j := 35, k := 18, use := 0, tree := hex% "50000000000000000000000000000000000000000000000010000000005c23e1f80000000000000000000000000000000000000000158397f0000000000000004501a18205098" }]

/-- The group 87: the cover of a box by its cells. -/
theorem g87_ok : boxOk run { e1 := 4, c1 := 0, e2 := 4, c2 := 10, e3 := 3, c3 := 8 } (3) cells87 = true := by
  decide +kernel

