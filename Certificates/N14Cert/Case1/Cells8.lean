module

public import N14Cert.Case1.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case1

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 65. -/
noncomputable def cells65 : List Cell :=
  [{ i := 26, j := 36, k := 37, use := 0, tree := hex% "" }]

/-- The group 65: the cover of a box by its cells. -/
theorem g65_ok : boxOk run { e1 := 4, c1 := 1, e2 := 4, c2 := 11, e3 := 4, c3 := 12 } (3) cells65 = true := by
  decide +kernel

