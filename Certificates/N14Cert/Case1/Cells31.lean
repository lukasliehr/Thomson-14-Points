module

public import N14Cert.Case1.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case1

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 252. -/
noncomputable def cells252 : List Cell :=
  [{ i := 139, j := 205, k := 211, use := 0, tree := hex% "db60000000000000000000000000000000000000000000000000000000001ce736d08458" },
    { i := 139, j := 205, k := 212, use := 0, tree := hex% "" }]

/-- The group 252: the cover of a box by its cells. -/
theorem g252_ok : boxOk run { e1 := 6, c1 := 21, e2 := 6, c2 := 86, e3 := 5, c3 := 46 } (62) cells252 = true := by
  decide +kernel

