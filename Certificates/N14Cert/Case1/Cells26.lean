/-- The cells of the group 213. -/
noncomputable def cells213 : List Cell :=
  [{ i := 137, j := 199, k := 103, use := 0, tree := hex% "d800000000000000000000000000000000000000000000000000000000020149542c2" },
    { i := 137, j := 200, k := 213, use := 0, tree := 3 },
    { i := 137, j := 200, k := 214, use := 0, tree := hex% "" }]

/-- The group 213: the cover of a box by its cells. -/
theorem g213_ok : boxOk run { e1 := 6, c1 := 19, e2 := 5, c2 := 40, e3 := 5, c3 := 47 } (1005) cells213 = true := by
  decide +kernel

