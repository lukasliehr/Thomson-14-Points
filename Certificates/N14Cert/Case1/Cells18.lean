module

public import N14Cert.Case1.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case1

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 144. -/
noncomputable def cells144 : List Cell :=
  [{ i := 58, j := 41, k := 47, use := 0, tree := hex% "" }]

/-- The group 144: the cover of a box by its cells. -/
theorem g144_ok : boxOk run { e1 := 5, c1 := 2, e2 := 4, c2 := 16, e3 := 4, c3 := 22 } (3) cells144 = true := by
  decide +kernel

