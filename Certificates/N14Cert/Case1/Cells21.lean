/-- The cells of the group 169. -/
noncomputable def cells169 : List Cell :=
  [{ i := 27, j := 43, k := 47, use := 0, tree := hex% "" },
    { i := 27, j := 43, k := 48, use := 0, tree := hex% "" }]

/-- The group 169: the cover of a box by its cells. -/
theorem g169_ok : boxOk run { e1 := 4, c1 := 2, e2 := 4, c2 := 18, e3 := 3, c3 := 11 } (62) cells169 = true := by
  decide +kernel

