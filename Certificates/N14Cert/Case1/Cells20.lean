/-- The cells of the group 161. -/
noncomputable def cells161 : List Cell :=
  [{ i := 126, j := 89, k := 103, use := 0, tree := hex% "" },
    { i := 127, j := 89, k := 103, use := 0, tree := hex% "" }]

