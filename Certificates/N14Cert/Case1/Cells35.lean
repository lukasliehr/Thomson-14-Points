module

public import N14Cert.Case1.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case1

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 280. -/
noncomputable def cells280 : List Cell :=
  [{ i := 140, j := 207, k := 211, use := 0, tree := hex% "" }]

/-- The group 280: the cover of a box by its cells. -/
theorem g280_ok : boxOk run { e1 := 6, c1 := 22, e2 := 6, c2 := 88, e3 := 6, c3 := 92 } (3) cells280 = true := by
  decide +kernel

