module

public import N14Cert.Case1.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case1

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 7. -/
noncomputable def cells7 : List Cell :=
  [{ i := 12, j := 4, k := 6, use := 0, tree := hex% "" },
    { i := 13, j := 4, k := 6, use := 0, tree := hex% "fe2e4f800000000000000000000000017257f540a8682a5b6c000000000000000000000000000000000000000000000000000000000edbd98202986536d8291" }]

/-- The group 7: the cover of a box by its cells. -/
theorem g7_ok : boxOk run { e1 := 2, c1 := 1, e2 := 2, c2 := 1, e3 := 2, c3 := 3 } (60) cells7 = true := by
  decide +kernel

