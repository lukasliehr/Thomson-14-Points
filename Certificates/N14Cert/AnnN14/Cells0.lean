module

public import N14Cert.AnnN14.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.AnnN14

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 9, j := 9, k := 11, use := 3, tree := hex% "" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 10, c1 := 108, e2 := 10, c2 := 108, e3 := 13, c3 := 13136 } (3) cells0 = true := by
  decide +kernel

/-- The cells of the group 1. -/
noncomputable def cells1 : List Cell :=
  [{ i := 9, j := 9, k := 12, use := 3, tree := hex% "" }]

/-- The group 1: the cover of a box by its cells. -/
theorem g1_ok : boxOk run { e1 := 10, c1 := 108, e2 := 10, c2 := 108, e3 := 13, c3 := 13137 } (3) cells1 = true := by
  decide +kernel

/-- The cells of the group 2. -/
noncomputable def cells2 : List Cell :=
  [{ i := 9, j := 10, k := 11, use := 3, tree := hex% "" }]

/-- The group 2: the cover of a box by its cells. -/
theorem g2_ok : boxOk run { e1 := 10, c1 := 108, e2 := 10, c2 := 109, e3 := 13, c3 := 13136 } (3) cells2 = true := by
  decide +kernel

end N14Cert.AnnN14
