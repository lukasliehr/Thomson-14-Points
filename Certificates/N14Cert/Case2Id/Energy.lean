/-- The stored cutoffs `-0.99` and `-0.98` of the source, binary64 numbers. -/
noncomputable def bLow : ℝ := (45035996273705 : ℝ) / 4503599627370496 - 1

noncomputable def bHigh : ℝ := (45035996273705 : ℝ) / 2251799813685248 - 1

/-- The slack function of the pattern PPR is nonnegative at the inner products of the pair `P` with a third
point: the first argument lies between the two cutoffs and is the smallest one. -/
theorem ppr_nonneg (u v t : ℝ) (hu : -1 ≤ u) (hv1 : v < 1) (ht1 : t < 1) (hg : 0 ≤ gram u v t)
    (hlo : bLow ≤ u) (hhi : u ≤ bHigh) (huv : u ≤ v) (hut : u ≤ t) : 0 ≤ cert.ppr.lam u v t := by
  refine ge_of_sorted23 cert.ppr.lam (cert.ppr_swap23 cert_ok)
    (fun u v t => -1 ≤ u ∧ v < 1 ∧ t < 1 ∧ 0 ≤ gram u v t ∧ bLow ≤ u ∧ u ≤ bHigh ∧ u ≤ v ∧ u ≤ t) ?_ 0 ?_
    u v t ⟨hu, hv1, ht1, hg, hlo, hhi, huv, hut⟩
  · rintro u v t ⟨a, b, c, d, e, f, g, h⟩
    exact ⟨a, c, b, by rw [gram_swap23]; exact d, e, f, h, g⟩
  · rintro u v t hvt ⟨a, b, c, d, e, f, g, h⟩
    unfold bLow at e
    unfold bHigh at f
    refine N14Cert.Case2Ppr.slack_nonneg u v t a (by linarith) (by linarith) ?_
    refine ⟨by linarith, b, c, d, ?_, ?_⟩
    · intro cut hc
      have hc' : cut ∈ [{ kind := 0, a := 0, b := 0, vn := 45035996273705, vd := 4503599627370496 }, { kind := 1, a := 0, b := 0, vn := 45035996273705, vd := 2251799813685248 }, { kind := 2, a := 1, b := 0, vn := 0, vd := 1 }, { kind := 2, a := 2, b := 1, vn := 0, vd := 1 }] := hc
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hc'
      rcases hc' with rfl | rfl | rfl | rfl <;> simp [cutVal, co] <;> linarith
    · intro Pp hPp
      exact absurd (show Pp ∈ ([] : List ℕ) from hPp) List.not_mem_nil

/-- The slack function of the pattern PRR is nonnegative at the inner products of a point of the pair `P`
with two other points, if all three are at least the lower cutoff. -/
theorem prr_nonneg (u v t : ℝ) (hu : -1 ≤ u) (hv : -1 ≤ v) (ht : -1 ≤ t) (hu1 : u < 1) (hv1 : v < 1) (ht1 : t < 1)
    (hg : 0 ≤ gram u v t) (h1 : bLow ≤ u) (h2 : bLow ≤ v) (h3 : bLow ≤ t) :
    0 ≤ cert.prr.lam u v t := by
  refine ge_of_sorted12 cert.prr.lam (cert.prr_swap12 cert_ok)
    (fun u v t => (-1 ≤ u ∧ -1 ≤ v ∧ -1 ≤ t) ∧ (u < 1 ∧ v < 1 ∧ t < 1) ∧ 0 ≤ gram u v t ∧ bLow ≤ u ∧ bLow ≤ v ∧ bLow ≤ t)
    ?_ 0 ?_ u v t ⟨⟨hu, hv, ht⟩, ⟨hu1, hv1, ht1⟩, hg, h1, h2, h3⟩
  · rintro u v t ⟨⟨a1, a2, a3⟩, ⟨b1, b2, b3⟩, d, e1, e2, e3⟩
    exact ⟨⟨a2, a1, a3⟩, ⟨b2, b1, b3⟩, by rw [gram_swap12]; exact d, e2, e1, e3⟩
  · rintro u v t huv ⟨⟨a1, a2, a3⟩, ⟨b1, b2, b3⟩, d, e1, e2, e3⟩
    unfold bLow at e1 e2 e3
    refine N14Cert.Case2Prr.slack_nonneg u v t a1 a2 a3 ?_
    refine ⟨b1, b2, b3, d, ?_, ?_⟩
    · intro cut hc
      have hc' : cut ∈ [{ kind := 0, a := 0, b := 0, vn := 45035996273705, vd := 4503599627370496 }, { kind := 0, a := 2, b := 0, vn := 45035996273705, vd := 4503599627370496 }, { kind := 2, a := 1, b := 0, vn := 0, vd := 1 }] := hc
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hc'
      rcases hc' with rfl | rfl | rfl <;> simp [cutVal, co] <;> linarith
    · intro Pp hPp
      exact absurd (show Pp ∈ ([] : List ℕ) from hPp) List.not_mem_nil

/-- The slack function of the pattern RRR is nonnegative at the inner products of three points, if all three
are at least the lower cutoff. -/
theorem rrr_nonneg (u v t : ℝ) (hu : -1 ≤ u) (hv : -1 ≤ v) (ht : -1 ≤ t) (hu1 : u < 1) (hv1 : v < 1) (ht1 : t < 1)
    (hg : 0 ≤ gram u v t) (h1 : bLow ≤ u) (h2 : bLow ≤ v) (h3 : bLow ≤ t) :
    0 ≤ cert.rrr.lam u v t := by
  refine ge_of_sorted cert.rrr.lam (cert.rrr_swap12 cert_ok) (cert.rrr_swap23 cert_ok)
    (fun u v t => (-1 ≤ u ∧ -1 ≤ v ∧ -1 ≤ t) ∧ (u < 1 ∧ v < 1 ∧ t < 1) ∧ 0 ≤ gram u v t ∧ bLow ≤ u ∧ bLow ≤ v ∧ bLow ≤ t)
    ?_ ?_ 0 ?_ u v t ⟨⟨hu, hv, ht⟩, ⟨hu1, hv1, ht1⟩, hg, h1, h2, h3⟩
