theorem Efam_eq (h : ℝ) : N14.Efam h = E h := rfl

theorem hDec_eq : N14.hDec = hDec := rfl

theorem hDec_bounds : (455 : ℝ) / 1000 < hDec ∧ hDec < 456 / 1000 := by
  unfold hDec
  constructor <;> norm_num

/-- A height within `10⁻⁴⁰` of `hDec` lies in `(0, 1)`. -/
theorem unit_of_near (y : ℝ) (hy : |y - hDec| ≤ 1 / 10 ^ 40) : 0 < y ∧ y < 1 := by
  obtain ⟨b1, b2⟩ := hDec_bounds
  rw [abs_le] at hy
  have e : (1 : ℝ) / 10 ^ 40 ≤ 1 / 1000 := by norm_num
  constructor <;> linarith [hy.1, hy.2]

/-- Near a height of `(0, 1)` the energy of the family is the function `E`. -/
theorem hasDerivAt_iff (y : ℝ) (h0 : 0 < y) (h1 : y < 1) (d : ℝ) :
    HasDerivAt (fun t => energy (X14 t)) d y ↔ HasDerivAt E d y := by
  have ev : (fun t => energy (X14 t)) =ᶠ[nhds y] E := by
    filter_upwards [Ioo_mem_nhds h0 h1] with t ht
    rw [energy_X14 t ht.1 ht.2, Efam_eq]
  exact ⟨fun H => H.congr_of_eventuallyEq ev.symm, fun H => H.congr_of_eventuallyEq ev⟩

theorem stationary_iff (y : ℝ) :
    StationaryHeight y ↔ |y - hDec| ≤ 1 / 10 ^ 40 ∧ HasDerivAt E 0 y := by
  unfold StationaryHeight
  rw [hDec_eq]
  constructor
  · rintro ⟨a, b⟩
    obtain ⟨h0, h1⟩ := unit_of_near y a
    exact ⟨a, (hasDerivAt_iff y h0 h1 0).mp b⟩
  · rintro ⟨a, b⟩
    obtain ⟨h0, h1⟩ := unit_of_near y a
    exact ⟨a, (hasDerivAt_iff y h0 h1 0).mpr b⟩

/-- **Lemma 1.1 of the source, existence and uniqueness**: the family has exactly one stationary height within
`10⁻⁴⁰` of `hDec`. -/
theorem stationary_unique : ∃! h, StationaryHeight h := by
  obtain ⟨hs, h1, h2, h3, _⟩ := stationary_height_decimal
  have e : (2 : ℝ) / 10 ^ 51 ≤ 1 / 10 ^ 40 := by norm_num
  refine ⟨hs, (stationary_iff hs).mpr ⟨le_trans h1 e, h2⟩, fun y hy => ?_⟩
  obtain ⟨a, b⟩ := (stationary_iff y).mp hy
  exact h3 y a b

theorem hStar_stationary : StationaryHeight hStar := by
  have H : ∃ h, StationaryHeight h := stationary_unique.exists
  unfold hStar
  rw [dif_pos H]
  exact Classical.choose_spec H

/-- Every stationary height near `hDec` is `hStar`. -/
theorem eq_hStar (y : ℝ) (hy : StationaryHeight y) : y = hStar :=
  stationary_unique.unique hy hStar_stationary

/-- **The enclosure of the stationary height**: `|hStar - hMid| < 2⁻²⁰⁰` for the dyadic number `hMid`. -/
theorem hStar_mid : |hStar - hMid| < 1 / 2 ^ 200 := by
  obtain ⟨hs, h1, h2, _, _⟩ := stationary_height
  have e1 : |hMid - hDec| ≤ 2 / 10 ^ 51 - 1 / 2 ^ 200 := by
    unfold hMid hDec
    rw [abs_le]
    constructor <;> norm_num
  have e2 : (2 : ℝ) / 10 ^ 51 ≤ 1 / 10 ^ 40 := by norm_num
  have hy : StationaryHeight hs := by
    refine (stationary_iff hs).mpr ⟨?_, h2⟩
    rw [abs_lt] at h1
    rw [abs_le] at e1 ⊢
    constructor <;> linarith [h1.1, h1.2, e1.1, e1.2]
  rw [← eq_hStar hs hy]
  exact h1

/-- **Lemma 1.1 of the source, the height**: `|hStar - hDec| ≤ 2 · 10⁻⁵¹`. -/
theorem hStar_dec : |hStar - N14.hDec| ≤ 2 / 10 ^ 51 := by
  obtain ⟨hs, h1, h2, _, _⟩ := stationary_height_decimal
  have e : (2 : ℝ) / 10 ^ 51 ≤ 1 / 10 ^ 40 := by norm_num
  rw [hDec_eq, ← eq_hStar hs ((stationary_iff hs).mpr ⟨le_trans h1 e, h2⟩)]
  exact h1

theorem hStar_unit : 0 < hStar ∧ hStar < 1 := by
  have h := hStar_stationary.1
  rw [hDec_eq] at h
  exact unit_of_near hStar h

/-- The energy of the candidate is the value of formula (1.1) at the stationary height. -/
theorem energy_Xstar : energy Xstar = E hStar := by
  unfold Xstar
  rw [energy_X14 hStar hStar_unit.1 hStar_unit.2, Efam_eq]

/-- **Lemma 1.1 of the source, the energy**: `|energy Xstar - E0| ≤ 10⁻⁴⁹` for the decimal number `E0`. -/
theorem Estar_enclosure : |energy Xstar - E0| ≤ 1 / 10 ^ 49 := by
  rw [energy_Xstar]
  exact energy_enclosure hStar hStar_mid.le

