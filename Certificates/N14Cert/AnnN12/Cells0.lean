module

public import N14Cert.AnnN12.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.AnnN12

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 5, j := 5, k := 5, use := 3, tree := hex% "2d16b60d6000000000000008000000000000000120000000000000000000000000000000000000000000059f80000000000000000000000000000036c0000000000000000000000000000098200000000000000011a21a212" },
    { i := 9, j := 8, k := 9, use := 3, tree := hex% "d86996da6d10d368a" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 6, c1 := 92, e2 := 5, c2 := 46, e3 := 5, c3 := 25 } (66297069) cells0 = true := by
  decide +kernel

