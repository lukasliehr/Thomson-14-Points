module

public import N14Cert.CoreN15.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.CoreN15

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 13, j := 11, k := 11, use := 3, tree := hex% "" },
    { i := 12, j := 11, k := 10, use := 3, tree := hex% "" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 1, c1 := 0, e2 := 1, c2 := 0, e3 := 1, c3 := 2 } (hex% "3fffffff7fc93b724e49cedc93b739ced3b4") cells0 = true := by
  decide +kernel

end N14Cert.CoreN15
