/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 3, j := 0, k := 0, use := 0, tree := 5 },
    { i := 4, j := 3, k := 0, use := 0, tree := 5 },
    { i := 4, j := 4, k := 3, use := 0, tree := 5 },
    { i := 4, j := 4, k := 4, use := 0, tree := hex% "7000000000006ec3ec" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 1, c1 := 0, e2 := 1, c2 := 0, e3 := 1, c3 := 0 } (16092) cells0 = true := by
  decide +kernel

