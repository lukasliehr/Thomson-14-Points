module

public import N14Cert.CapPrr.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.CapPrr

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 145. -/
noncomputable def cells145 : List Cell :=
  [{ i := 197, j := 204, k := 62, use := 0, tree := hex% "" },
    { i := 197, j := 205, k := 62, use := 0, tree := hex% "" },
    { i := 198, j := 100, k := 62, use := 0, tree := hex% "" }]

/-- The group 145: the cover of a box by its cells. -/
theorem g145_ok : boxOk run { e1 := 5, c1 := 41, e2 := 5, c2 := 46, e3 := 5, c3 := 8 } (1012) cells145 = true := by
  decide +kernel

