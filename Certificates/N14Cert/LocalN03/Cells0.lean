module

public import N14Cert.LocalN03.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.LocalN03

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 3, j := 3, k := 3, use := 3, tree := hex% "" },
    { i := 3, j := 3, k := 4, use := 3, tree := hex% "" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 1, c1 := 1, e2 := 1, c2 := 1, e3 := 1, c3 := 1 } (274877457636) cells0 = true := by
  decide +kernel

end N14Cert.LocalN03
