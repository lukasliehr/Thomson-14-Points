/-- The group 11: the cover of a box by its cells. -/
theorem g11_ok : boxOk run { e1 := 3, c1 := 1, e2 := 2, c2 := 2, e3 := 2, c3 := 2 } (16121) cells11 = true := by
  decide +kernel

