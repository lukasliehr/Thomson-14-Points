noncomputable def cells11 : List Cell :=
  [{ i := 11, j := 14, k := 14, use := 0, tree := 5 },
    { i := 11, j := 14, k := 15, use := 0, tree := hex% "" },
    { i := 11, j := 15, k := 14, use := 0, tree := hex% "602c1e500000000000000000000000005fafa1f4" },
