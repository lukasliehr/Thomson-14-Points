module

public import N14Cert.CoreN14.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.CoreN14

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 2. -/
noncomputable def cells2 : List Cell :=
  [{ i := 11, j := 12, k := 14, use := 3, tree := hex% "" }]

/-- The group 2: the cover of a box by its cells. -/
theorem g2_ok : boxOk run { e1 := 12, c1 := 434, e2 := 12, c2 := 435, e3 := 15, c3 := 52549 } (3) cells2 = true := by
  decide +kernel

end N14Cert.CoreN14
