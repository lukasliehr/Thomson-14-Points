module

public import N14Cert.CoreN14.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.CoreN14

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 11, j := 11, k := 13, use := 3, tree := 69 },
    { i := 11, j := 11, k := 14, use := 3, tree := hex% "" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 12, c1 := 434, e2 := 12, c2 := 434, e3 := 11, c3 := 3284 } (261818) cells0 = true := by
  decide +kernel

/-- The cells of the group 1. -/
noncomputable def cells1 : List Cell :=
  [{ i := 11, j := 12, k := 13, use := 3, tree := hex% "" }]

/-- The group 1: the cover of a box by its cells. -/
theorem g1_ok : boxOk run { e1 := 12, c1 := 434, e2 := 12, c2 := 435, e3 := 15, c3 := 52548 } (3) cells1 = true := by
  decide +kernel

end N14Cert.CoreN14
