/-- The data of the certificate for the run `N14Cert.Case1.run`. -/
noncomputable def certCase1 : UCert :=
  { P := P, blocks := blocks0, R := N14Cert.Case1.run,
    U1 := N14Cert.Case1.tab0, U2 := N14Cert.Case1.tab1, U3 := N14Cert.Case1.tab1,
    N := 14, cM := 2, cK := 1, wB := 225, aB := 225,
    B := hex% "",
    cp := 0, cn := hex% "c00000000000000000000000000000001014117aff0a65e52746289e",
    kp := 0, kn := hex% "13bf8644b4a68274b2ddbe9dc758",
    fS := hex% "444000000000000000000000000" }

/-- The kernel accepts the identity of the run: its mixed part is that of the six kernels. -/
theorem certCase1_id3 : id3Ok P certCase1.id3 = true := by decide +kernel

/-- The kernel accepts the identity of a pair. -/
theorem certCase1_id1 : id1Ok P certCase1.id1 = true := by decide +kernel

/-- The sums of the coefficients of the two parts of the kernel: its value at `(1, 1, 1)`. -/
theorem certCase1_one : kern P ⟨0, 0, 0⟩ 0 blocks0 = (hex% "15a33bb9487d6622fc535b7fb30c7d7dc4f4bc4900b", hex% "15a33bb9487d6622fc5147ea787d25926e870c133b6") := by
  decide +kernel

theorem certCase1_ok : certCase1.Ok :=
  { h3 := certCase1_id3, h1 := certCase1_id1, hW := rfl, hPD := blocks0_pd,
    hc1 := by decide, hcM := by decide, hN := by decide,
    hT2 := fun s => tabFn_congr _ _ rfl rfl rfl rfl rfl rfl s,
    hT3 := fun s => tabFn_congr _ _ rfl rfl rfl rfl rfl rfl s }

/-- The lower bound for the inner products in Case I: the stored cutoff `-0.98`, a binary64 number. -/
noncomputable def aLow : ℝ := (45035996273705 : ℝ) / 2251799813685248 - 1

/-- The slack function of the certificate is nonnegative at ordered arguments of its domain. -/
theorem lam_sorted (u v t : ℝ) (huv : u ≤ v) (hvt : v ≤ t) (hu : -1 ≤ u) (ht1 : t < 1)
    (hg : 0 ≤ gram u v t) (ha : aLow ≤ u) : 0 ≤ certCase1.lam u v t := by
  unfold aLow at ha
  refine N14Cert.Case1.slack_nonneg u v t hu (by linarith) (by linarith) ?_
  refine ⟨by linarith, by linarith, ht1, hg, ?_, ?_⟩
  · intro cut hc
    have hc' : cut ∈ [{ kind := 0, a := 0, b := 0, vn := 45035996273705, vd := 2251799813685248 }, { kind := 2, a := 1, b := 0, vn := 0, vd := 1 }, { kind := 2, a := 2, b := 1, vn := 0, vd := 1 }] := hc
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc'
    rcases hc' with rfl | rfl | rfl <;> simp [cutVal, co] <;> linarith
  · intro Pp hPp
    exact absurd (show Pp ∈ ([] : List ℕ) from hPp) List.not_mem_nil

/-- **Case I: every configuration of 14 points of the unit sphere all of whose inner products are at least
`aLow` has Coulomb energy at least the offset of the certificate.** -/
theorem energy_ge (x : Fin 14 → EuclideanSpace ℝ (Fin 3)) (hx : ∀ i, ‖x i‖ = 1)
    (hinj : Function.Injective x) (ha : ∀ i j, i ≠ j → aLow ≤ inner ℝ (x i) (x j)) :
    (163646883327020528602849 : ℝ) / 2361183241434822606848
      ≤ ∑ i, ∑ j ∈ univ.filter (fun j => i < j), 1 / dist (x i) (x j) := by
  have hC := certCase1_ok
  have hmain := certCase1.energy_ge hC _ _ 163646883327020528602849 2361183241434822606848 certCase1_one (by decide) (by decide)
    (by decide +kernel) x hx
  have hpos : 0 ≤ dsum (fun i j k => certCase1.lam (ip x i j) (ip x i k) (ip x j k)) := by
    refine sum3_nonneg fun i j k => ?_
    split_ifs with hd
    · exact lam_region certCase1 hC (fun s => aLow ≤ s) 0
        (fun u v t huv hvt hu ht1 hg h1 _ _ => lam_sorted u v t huv hvt hu ht1 hg h1) x hx hinj i j k hd
        (ha i j hd.1) (ha i k hd.2.1) (ha j k hd.2.2)
    · exact le_refl 0
  have hc1 : (0 : ℝ) ≤ (certCase1.U1.c1 : ℝ) := Nat.cast_nonneg _
  have hf : (0 : ℝ) ≤ 6 * (certCase1.fS : ℝ) := by positivity
  have := div_nonneg (mul_nonneg hc1 hpos) hf
  push_cast at hmain
  exact le_trans (le_add_of_nonneg_right this) hmain

/-- info: 'N14Cert.Case1Id.energy_ge' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms energy_ge

end N14Cert.Case1Id
