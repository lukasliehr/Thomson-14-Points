module

public import N14Cert.AnnN06.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.AnnN06

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 9, j := 6, k := 6, use := 3, tree := hex% "" },
    { i := 10, j := 8, k := 9, use := 3, tree := hex% "" },
    { i := 10, j := 9, k := 9, use := 3, tree := hex% "" },
    { i := 10, j := 8, k := 8, use := 3, tree := 61750454537167898 },
    { i := 10, j := 9, k := 8, use := 3, tree := 964850852044954 }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 6, c1 := 34, e2 := 5, c2 := 46, e3 := 5, c3 := 25 } (1125345748903725) cells0 = true := by
  decide +kernel

/-- The cells of the group 1. -/
noncomputable def cells1 : List Cell :=
  [{ i := 6, j := 5, k := 5, use := 3, tree := hex% "db6356d9682206a99612" }]

/-- The group 1: the cover of a box by its cells. -/
theorem g1_ok : boxOk run { e1 := 6, c1 := 35, e2 := 5, c2 := 46, e3 := 5, c3 := 25 } (1005) cells1 = true := by
  decide +kernel

end N14Cert.AnnN06
