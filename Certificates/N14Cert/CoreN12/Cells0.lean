module

public import N14Cert.CoreN12.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.CoreN12

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 0. -/
noncomputable def cells0 : List Cell :=
  [{ i := 10, j := 10, k := 10, use := 3, tree := hex% "" }]

/-- The group 0: the cover of a box by its cells. -/
theorem g0_ok : boxOk run { e1 := 11, c1 := 2980, e2 := 11, c2 := 2980, e3 := 11, c3 := 1660 } (3) cells0 = true := by
  decide +kernel

/-- The cells of the group 1. -/
noncomputable def cells1 : List Cell :=
  [{ i := 10, j := 10, k := 11, use := 3, tree := hex% "" }]

/-- The group 1: the cover of a box by its cells. -/
theorem g1_ok : boxOk run { e1 := 11, c1 := 2980, e2 := 11, c2 := 2980, e3 := 11, c3 := 1661 } (3) cells1 = true := by
  decide +kernel

end N14Cert.CoreN12
