module

public import N14Cert.Case2Ppr.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case2Ppr

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 35. -/
noncomputable def cells35 : List Cell :=
  [{ i := 8, j := 124, k := 235, use := 0, tree := hex% "" }]

/-- The group 35: the cover of a box by its cells. -/
theorem g35_ok : boxOk run { e1 := 7, c1 := 2, e2 := 6, c2 := 5, e3 := 6, c3 := 116 } (3) cells35 = true := by
  decide +kernel

/-- The cells of the group 36. -/
noncomputable def cells36 : List Cell :=
  [{ i := 6, j := 124, k := 236, use := 0, tree := 3 }]

/-- The group 36: the cover of a box by its cells. -/
theorem g36_ok : boxOk run { e1 := 6, c1 := 1, e2 := 6, c2 := 5, e3 := 6, c3 := 117 } (3) cells36 = true := by
  decide +kernel

/-- The cells of the group 37. -/
noncomputable def cells37 : List Cell :=
  [{ i := 5, j := 58, k := 115, use := 0, tree := hex% "1880000005207541efc" }]

/-- The group 37: the cover of a box by its cells. -/
theorem g37_ok : boxOk run { e1 := 6, c1 := 0, e2 := 5, c2 := 2, e3 := 5, c3 := 59 } (3) cells37 = true := by
  decide +kernel

end N14Cert.Case2Ppr
