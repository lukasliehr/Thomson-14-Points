module

public import N14Cert.Case2Ppr.Run
public import N14.Box.MasterKernel
import CAP.Transport.Hex

@[expose] public section

namespace N14Cert.Case2Ppr

open N14.Box

set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option exponentiation.threshold 100000

/-- The cells of the group 33. -/
noncomputable def cells33 : List Cell :=
  [{ i := 8, j := 123, k := 235, use := 0, tree := hex% "" }]

/-- The group 33: the cover of a box by its cells. -/
theorem g33_ok : boxOk run { e1 := 6, c1 := 1, e2 := 6, c2 := 4, e3 := 6, c3 := 116 } (60) cells33 = true := by
  decide +kernel

end N14Cert.Case2Ppr
